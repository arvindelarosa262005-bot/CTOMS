# Frontend (Admin-Web) runtime env vars for Vercel.
# Set these in the Vercel project dashboard (Settings > Environment Variables) BEFORE deploy.

# Full public HTTPS URL of the deployed backend API, WITHOUT a trailing slash.
# Example: https://ctoms-api.up.railway.app
VITE_API_URL=https://YOUR-BACKEND-URL.example

# Full public HTTPS URL of the SignalR hub.
# Example: https://ctoms-api.up.railway.app/hubs/ctoms
VITE_SIGNALR_HUB_URL=https://YOUR-BACKEND-URL.example/hubs/ctoms
